{
  "name": "genesis-cypress-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas E2E automatizadas con Cypress para Génesis Fashion (PPI - Quinto semestre)",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:login": "cypress run --spec cypress/e2e/01_login_empleado.cy.ts",
    "cy:run:registro": "cypress run --spec cypress/e2e/02_registro_cliente.cy.ts",
    "cy:run:cliente": "cypress run --spec cypress/e2e/03_login_cliente_catalogo.cy.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "typescript": "^5.6.0"
  }
}
